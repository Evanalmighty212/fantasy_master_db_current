venv/
venv.old-py39/
__pycache__/
*.pyc
.DS_Store
.vscode/

data/raw/
data/processed/
data/master/
data/exports/
# data/manual/ is intentionally NOT ignored - hand-maintained source data
outputs/

# research/output/ is pipeline-regenerated (same convention as data/
# above) -- rerun the scripts in research/dataset3/README.md's "Run
# order" to reproduce it, never commit it directly.
research/output/

# raw-fetch caches from Stars-by-Value research -- same convention as
# data/raw/ above, pure re-fetchable HTTP cache, never meant to be
# curated or committed. research/diagnostics/mfl_pipeline/output/ and
# research/diagnostics/mfl/ are deliberately NOT listed here -- both
# contain a mix of curated and generated artifacts, not evaluated yet.
research/diagnostics/mfl_pipeline/cache/
research/diagnostics/nflverse/

# scripts/mfl_source_manifest.json IS committed (unlike the raw MFL
# JSON responses under data/raw/mfl/, which stay gitignored above) --
# it's a compact snapshot registry (URL/params, retrieved_at, sha256,
# totalDrafts, row_count, sbv_version per season/endpoint), not
# disposable bookkeeping. See mfl_client.py's module docstring for
# exactly what it documents and its limits (it records what snapshot
# was used; it cannot itself reproduce MFL's live, continuously-growing
# report byte-for-byte).

*.log
.ipynb_checkpoints/
.pytest_cache/
